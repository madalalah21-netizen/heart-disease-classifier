from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score
)
import pandas as pd

models_predictions = {
    "Logistic Regression": logistic_model.predict(X_test),
    "Decision Tree": decision_tree_model.predict(X_test),
    "Random Forest": random_forest_model.predict(X_test),
    "SVM": svm_model.predict(X_test),
    "MLP": mlp_model.predict(X_test)
}

comparison_results = []

for model_name, predictions in models_predictions.items():
    comparison_results.append({
        "Algorithm": model_name,
        "Accuracy": accuracy_score(y_test, predictions),
        "Precision": precision_score(y_test, predictions),
        "Recall": recall_score(y_test, predictions),
        "F1-Score": f1_score(y_test, predictions)
    })

comparison_df = pd.DataFrame(comparison_results)

comparison_df = comparison_df.sort_values(
    by="Accuracy",
    ascending=False
)

display(comparison_df.round(4))


from sklearn.model_selection import StratifiedKFold, cross_validate
import pandas as pd

models = {
    "Logistic Regression": logistic_model,
    "Decision Tree": decision_tree_model,
    "Random Forest": random_forest_model,
    "SVM": svm_model,
    "MLP": mlp_model
}

cv = StratifiedKFold(
    n_splits=5,
    shuffle=True,
    random_state=42
)

scoring = {
    "accuracy": "accuracy",
    "precision": "precision",
    "recall": "recall",
    "f1": "f1"
}

cv_results = []

for model_name, model in models.items():

    scores = cross_validate(
        model,
        X_train,
        y_train,
        cv=cv,
        scoring=scoring
    )

    cv_results.append({
        "Algorithm": model_name,
        "Accuracy Mean": scores["test_accuracy"].mean(),
        "Accuracy Std": scores["test_accuracy"].std(),
        "Precision Mean": scores["test_precision"].mean(),
        "Recall Mean": scores["test_recall"].mean(),
        "F1 Mean": scores["test_f1"].mean()
    })

cv_comparison = pd.DataFrame(cv_results)

display(
    cv_comparison.sort_values(
        by="Accuracy Mean",
        ascending=False
    ).round(4)
)


final_comparison = comparison_df.merge(
    cv_comparison,
    on="Algorithm",
    how="inner"
)

final_comparison = final_comparison.sort_values(
    by="Accuracy Mean",
    ascending=False
)

display(final_comparison.round(4))


from sklearn.model_selection import GridSearchCV

param_grid = {
    "classifier__C": [0.01, 0.1, 1, 10, 100]
}

grid_search_lr = GridSearchCV(
    estimator=logistic_model,
    param_grid=param_grid,
    cv=cv,
    scoring="accuracy",
    n_jobs=-1
)

grid_search_lr.fit(X_train, y_train)

print("Best Parameters:", grid_search_lr.best_params_)
print("Best Cross-Validation Accuracy:", grid_search_lr.best_score_)


from sklearn.model_selection import GridSearchCV

param_grid_rf = {
    "classifier__n_estimators": [100, 200, 300],
    "classifier__max_depth": [None, 5, 10, 15],
    "classifier__min_samples_split": [2, 5, 10],
    "classifier__min_samples_leaf": [1, 2, 4]
}

grid_search_rf = GridSearchCV(
    estimator=random_forest_model,
    param_grid=param_grid_rf,
    cv=cv,
    scoring="accuracy",
    n_jobs=-1
)

grid_search_rf.fit(X_train, y_train)

print("Best Parameters:", grid_search_rf.best_params_)
print("Best Cross-Validation Accuracy:", grid_search_rf.best_score_)


param_grid_svm = {
    "classifier__C": [0.1, 1, 10, 100],
    "classifier__kernel": ["linear", "rbf"],
    "classifier__gamma": ["scale", "auto", 0.01, 0.1, 1]
}

grid_search_svm = GridSearchCV(
    estimator=svm_model,
    param_grid=param_grid_svm,
    cv=cv,
    scoring="accuracy",
    n_jobs=-1
)

grid_search_svm.fit(X_train, y_train)

print("Best Parameters:", grid_search_svm.best_params_)
print("Best Cross-Validation Accuracy:", grid_search_svm.best_score_)


param_grid_mlp = {
    "classifier__hidden_layer_sizes": [
        (50,),
        (100,),
        (100, 50),
        (100, 50, 25)
    ],
    "classifier__alpha": [0.0001, 0.001, 0.01],
    "classifier__learning_rate_init": [0.001, 0.01]
}

grid_search_mlp = GridSearchCV(
    estimator=mlp_model,
    param_grid=param_grid_mlp,
    cv=cv,
    scoring="accuracy",
    n_jobs=-1
)

grid_search_mlp.fit(X_train, y_train)

print("Best Parameters:", grid_search_mlp.best_params_)
print("Best Cross-Validation Accuracy:", grid_search_mlp.best_score_)


param_grid_dt = {
    "classifier__max_depth": [None, 3, 5, 10, 15],
    "classifier__min_samples_split": [2, 5, 10],
    "classifier__min_samples_leaf": [1, 2, 4, 6],
    "classifier__criterion": ["gini", "entropy"]
}

grid_search_dt = GridSearchCV(
    estimator=decision_tree_model,
    param_grid=param_grid_dt,
    cv=cv,
    scoring="accuracy",
    n_jobs=-1
)

grid_search_dt.fit(X_train, y_train)

print("Best Parameters:", grid_search_dt.best_params_)
print("Best Cross-Validation Accuracy:", grid_search_dt.best_score_)


tuned_models = {
    "Logistic Regression": grid_search_lr,
    "Decision Tree": grid_search_dt,
    "Random Forest": grid_search_rf,
    "SVM": grid_search_svm,
    "MLP": grid_search_mlp
}

tuning_comparison = []

for model_name, grid in tuned_models.items():

    original_score = cv_comparison.loc[
        cv_comparison["Algorithm"] == model_name,
        "Accuracy Mean"
    ].values[0]

    tuned_score = grid.best_score_

    tuning_comparison.append({
        "Algorithm": model_name,
        "Before Tuning": original_score,
        "After Tuning": tuned_score,
        "Improvement": tuned_score - original_score
    })

tuning_comparison_df = pd.DataFrame(tuning_comparison)

tuning_comparison_df = tuning_comparison_df.sort_values(
    by="After Tuning",
    ascending=False
)

display(tuning_comparison_df.round(4))


from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    confusion_matrix,
    classification_report
)

tuned_predictions = {}
final_test_results = []

for model_name, grid in tuned_models.items():

    best_model = grid.best_estimator_

    predictions = best_model.predict(X_test)

    tuned_predictions[model_name] = predictions

    final_test_results.append({
        "Algorithm": model_name,
        "Accuracy": accuracy_score(y_test, predictions),
        "Precision": precision_score(y_test, predictions),
        "Recall": recall_score(y_test, predictions),
        "F1-Score": f1_score(y_test, predictions)
    })

final_test_df = pd.DataFrame(final_test_results)

final_test_df = final_test_df.sort_values(
    by="Accuracy",
    ascending=False
)

display(final_test_df.round(4))


for model_name, predictions in tuned_predictions.items():

    print("\n" + "=" * 50)
    print(model_name)
    print("=" * 50)

    print("\nConfusion Matrix:")
    print(confusion_matrix(y_test, predictions))

    print("\nClassification Report:")
    print(classification_report(y_test, predictions))


from sklearn.metrics import roc_auc_score

roc_results = []

for model_name, grid in tuned_models.items():

    best_model = grid.best_estimator_

    if hasattr(best_model, "predict_proba"):
        scores = best_model.predict_proba(X_test)[:, 1]
    else:
        scores = best_model.decision_function(X_test)

    auc = roc_auc_score(y_test, scores)

    roc_results.append({
        "Algorithm": model_name,
        "ROC-AUC": auc
    })

roc_df = pd.DataFrame(roc_results)

roc_df = roc_df.sort_values(
    by="ROC-AUC",
    ascending=False
)

display(roc_df.round(4))


import matplotlib.pyplot as plt
from sklearn.metrics import roc_curve, auc

plt.figure(figsize=(10, 7))

for model_name, grid in tuned_models.items():

    best_model = grid.best_estimator_

    if hasattr(best_model, "predict_proba"):
        y_scores = best_model.predict_proba(X_test)[:, 1]
    else:
        y_scores = best_model.decision_function(X_test)

    fpr, tpr, thresholds = roc_curve(y_test, y_scores)

    roc_auc = auc(fpr, tpr)

    plt.plot(
        fpr,
        tpr,
        label=f"{model_name} (AUC = {roc_auc:.4f})"
    )

plt.plot(
    [0, 1],
    [0, 1],
    linestyle="--",
    label="Random Classifier"
)

plt.xlabel("False Positive Rate")
plt.ylabel("True Positive Rate")
plt.title("ROC Curves Comparison - Tuned Models")

plt.legend(loc="lower right")
plt.grid(alpha=0.3)
plt.show()


import joblib
import os

# اختيار أفضل نموذج Logistic Regression بعد ضبط المعاملات
final_model = grid_search_lr.best_estimator_

# مسار حفظ النموذج
model_path = "/kaggle/working/heart_disease_logistic_model.joblib"

# حفظ النموذج كاملًا
joblib.dump(final_model, model_path)

# التأكد من نجاح الحفظ
if os.path.exists(model_path):
    print("Model saved successfully!")
    print("File size:", round(os.path.getsize(model_path) / 1024, 2), "KB")
    print("Model:", final_model)
else:
    print("Model saving failed!")


# تحميل النموذج المحفوظ
loaded_model = joblib.load(model_path)

# اختيار سجل تجريبي من بيانات المشروع
sample_input = X_train.iloc[[0]]

# إجراء التنبؤ
prediction = loaded_model.predict(sample_input)

# استخراج احتمالات الفئتين
probabilities = loaded_model.predict_proba(sample_input)

print("Model loaded successfully!")
print("--------------------------------")
print("Predicted Class:", prediction[0])
print("Probability of Class 0:", round(probabilities[0][0] * 100, 2), "%")
print("Probability of Class 1:", round(probabilities[0][1] * 100, 2), "%")


